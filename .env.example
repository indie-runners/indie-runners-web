# PostgreSQL connection string
# Local TCP:   postgresql+psycopg://user:pass@localhost:5432/indie_runners
# Cloud SQL:   postgresql+psycopg://user:pass@/indie_runners?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/indie_runners

# Secret key used for session signing (generate with: openssl rand -hex 32)
# Rotate this value on deploy to invalidate all existing sessions
SECRET_KEY=change_me

# Set to true for local development
DEBUG=false

# Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Tile images
# Which tile version is served on the site. Corresponds to a prefix in
# gs://indie-runners-web-tiles/tiles/<version>/. Default lives in
# app/config.py (currently v02); set here only to override for local dev
# or to test a version temporarily. To make a new version the permanent
# default, edit app/config.py and commit.
# TILE_VERSION=v02

# Unsplash API access key, for scripts/unsplash_fetch.py only. Workstation
# tooling — never read by the app and not needed on Cloud Run. Register at
# https://unsplash.com/oauth/applications; the demo tier (50 requests/hour)
# is enough, since each event costs one search plus one download trigger.
# UNSPLASH_ACCESS_KEY=your-access-key
